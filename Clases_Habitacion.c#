
   using System;

class HabitacionHotel
{
    private int numero;
    private string tipo;
    private double precioPorNoche;
    private bool disponible;
    private string clienteActual;

    public int Numero
    {
        get { return numero; }
    }

    public string Tipo
    {
        get { return tipo; }
        set
        {
            if (value == "Individual" ||
                value == "Doble" ||
                value == "Suite")
            {
                tipo = value;
            }
            else
            {
                throw new ArgumentException(
                    "Tipo de habitación inválido.");
            }
        }
    }

    public double PrecioPorNoche
    {
        get { return precioPorNoche; }
        set
        {
            if (value > 0)
                precioPorNoche = value;
            else
                throw new ArgumentException(
                    "El precio debe ser mayor que cero.");
        }
    }

    public bool Disponible
    {
        get { return disponible; }
    }

    public string ClienteActual
    {
        get { return clienteActual; }
    }

    public HabitacionHotel(
        int numero, string tipo, double precioPorNoche)
    {
        if (numero <= 0)
            throw new ArgumentException(
                "El número debe ser mayor que cero.");

        this.numero = numero;
        Tipo = tipo;
        PrecioPorNoche = precioPorNoche;
        disponible = true;
        clienteActual = "";
    }

    public double Reservar(string nombreCliente, int noches)
    {
        if (!disponible)
        {
            Console.WriteLine(
                "La habitación " + numero + " está ocupada.");
            return -1;
        }

        if (string.IsNullOrWhiteSpace(nombreCliente) ||
            noches <= 0)
        {
            Console.WriteLine("Datos de reserva inválidos.");
            return -1;
        }

        disponible = false;
        clienteActual = nombreCliente;

        return precioPorNoche * noches;
    }

    public bool Liberar()
    {
        if (disponible)
            return false;

        disponible = true;
        clienteActual = "";

        return true;
    }

    public string MostrarInfo()
    {
        string estado = disponible
            ? "Disponible"
            : "Ocupada";

        string cliente = disponible
            ? "Ninguno"
            : clienteActual;

        return "Habitación: " + numero +
               "\nTipo: " + tipo +
               "\nPrecio por noche: $" +
               precioPorNoche.ToString("N0") +
               "\nEstado: " + estado +
               "\nCliente actual: " + cliente;
    }

    public void AplicarDescuento(int porcentaje)
    {
        if (porcentaje < 0 || porcentaje > 100)
        {
            Console.WriteLine(
                "El descuento debe estar entre 0 y 100.");
            return;
        }

        precioPorNoche -=
            precioPorNoche * porcentaje / 100.0;
    }
}

class Program
{
    static void Main(string[] args)
    {
        // Crear las tres habitaciones
        HabitacionHotel habitacion101 =
            new HabitacionHotel(101, "Individual", 50000);

        HabitacionHotel habitacion202 =
            new HabitacionHotel(202, "Doble", 80000);

        HabitacionHotel habitacion303 =
            new HabitacionHotel(303, "Suite", 150000);

        // Mostrar estado inicial
        Console.WriteLine("===== ESTADO INICIAL =====\n");

        Console.WriteLine(habitacion101.MostrarInfo());
        Console.WriteLine();

        Console.WriteLine(habitacion202.MostrarInfo());
        Console.WriteLine();

        Console.WriteLine(habitacion303.MostrarInfo());
        Console.WriteLine();

        // Reservar para Nathy Meza
        Console.WriteLine("===== RESERVAS =====");

        double costoNathy =
            habitacion101.Reservar("Nathy Meza", 3);

        Console.WriteLine(
            "Costo de Nathy Meza: $" +
            costoNathy.ToString("N0"));

        // Reservar para Diego Mercado
        double costoDiego =
            habitacion202.Reservar("Diego Mercado", 2);

        Console.WriteLine(
            "Costo de Diego Mercado: $" +
            costoDiego.ToString("N0"));

        // Intentar reservar nuevamente la habitación 101
        Console.WriteLine("\nIntento de segunda reserva:");

        double segundaReserva =
            habitacion101.Reservar("Diego Mercado", 1);

        if (segundaReserva == -1)
        {
            Console.WriteLine("La reserva fue rechazada.");
        }

        // Liberar la habitación 101
        Console.WriteLine("\nLiberar habitación 101:");

        if (habitacion101.Liberar())
            Console.WriteLine("Habitación 101 liberada.");
        else
            Console.WriteLine("La habitación ya estaba libre.");

        // Aplicar descuento del 10 % a la suite
        habitacion303.AplicarDescuento(10);

        Console.WriteLine(
            "\nDescuento del 10 % aplicado a la habitación 303.");

        // Reservar nuevamente para Nathy Meza
        double costoNathy2 =
            habitacion101.Reservar("Nathy Meza", 1);

        Console.WriteLine(
            "Costo de Nathy Meza: $" +
            costoNathy2.ToString("N0"));

        // Mostrar estado final
        Console.WriteLine("\n===== ESTADO FINAL =====\n");

        Console.WriteLine(habitacion101.MostrarInfo());
        Console.WriteLine();

        Console.WriteLine(habitacion202.MostrarInfo());
        Console.WriteLine();

        Console.WriteLine(habitacion303.MostrarInfo());
        Console.WriteLine();

        // Contar habitaciones ocupadas
        int ocupadas = 0;

        if (!habitacion101.Disponible)
            ocupadas++;

        if (!habitacion202.Disponible)
            ocupadas++;

        if (!habitacion303.Disponible)
            ocupadas++;

        Console.WriteLine(
            "Habitaciones ocupadas: " + ocupadas);

        Console.WriteLine("\nPresiona una tecla para salir...");
        Console.ReadKey();
    }
}